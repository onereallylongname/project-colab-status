#!/usr/bin/env bash

# Globals
VERSION=0.2.0
DEBUG=false
FORMAT=tsv
MODE=report

# Functions: helpers
usage() {
  cat <<EOF
Usage:
  git-colab-stats | ${0##*/} [options]

Options:
  --pretty      Human readable output
  --debug       Enable debug output
  --version     Print version
  -h, --help    Show help
EOF
}

usage_text() {
  cat <<EOF
Analyzes contribution data produced by git-colab-stats.

The generated metrics help answer:
  - Who contributes most to a boundary?
  - Who is most engaged with a boundary?
  - How concentrated is boundary knowledge?
  - What is the boundary's bus factor?

EOF
}

debug() {
  $DEBUG || return 0

  printf '[DEBUG] '
  printf -- "$@"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  --mode | -m)
    MODE="$2"
    shift 2
    ;;

  --format)
    FORMAT="$2"
    shift 2
    ;;

  --pretty)
    FORMAT=pretty
    shift
    ;;

  --debug)
    DEBUG=true
    shift
    ;;

  --version)
    printf '%s\n' "$VERSION"
    exit 0
    ;;

  -h)
    usage
    exit 0
    ;;

  --help)
    usage_text
    usage
    exit 0
    ;;

  *)
    printf 'Unknown option: %s\n' "$1" >&2
    exit 1
    ;;
  esac
done

# Functions: Code logic
build_boundary_model() {
  local boundary="$1"

  rows=()

  for key in "${!commits[@]}"; do

    current_boundary="${key%%|*}"
    author="${key#*|}"

    [[ "$current_boundary" != "$boundary" ]] && continue

    commit_count="${commits[$key]}"
    record_churn="${churn[$key]}"

    boundary_total_commits="${boundary_commits[$boundary]}"
    boundary_total_churn="${boundary_churn[$boundary]}"

    commit_pct=$(
      printf '%.1f' \
        "$((1000 * commit_count / boundary_total_commits))e-1"
    )

    churn_pct=$(
      printf '%.1f' \
        "$((1000 * record_churn / boundary_total_churn))e-1"
    )

    engagement=$(
      printf '%.1f' \
        "$((((\
        1000 * commit_count / boundary_total_commits) + (\
        1000 * record_churn / boundary_total_churn)) / \
        2))e-1"
    )

    rows+=(
      "${engagement}|${author}|${commit_pct}|${churn_pct}"
    )
  done

  mapfile -t sorted_rows < <(
    printf '%s\n' "${rows[@]}" |
      sort -t '|' -k1,1nr
  )

  most_active=""
  most_active_engagement=""
  bus_factor=0
  running_total=0

  for row in "${sorted_rows[@]}"; do

    IFS='|' read -r \
      engagement \
      author \
      commit_pct \
      churn_pct <<<"$row"

    if [[ -z "$most_active" ]]; then
      most_active="$author"
      most_active_engagement="$engagement"
    fi

    engagement_bp=${engagement/./}

    if ((running_total < 500)); then
      ((running_total += engagement_bp))
      ((bus_factor++))
    fi
  done
}

#
# Storage
#

declare -A commits
declare -A additions
declare -A deletions
declare -A churn

declare -A contributors_seen

declare -A boundary_commits
declare -A boundary_churn
declare -A boundaries_seen
declare -A boundary_bus_factor
declare -A boundary_contributor_count
declare -A boundary_most_active
declare -A boundary_most_active_engagement

collect_boundary_metrics() {

  ((${#boundary_bus_factor[@]} > 0)) && return

  for boundary in "${!boundaries_seen[@]}"; do

    build_boundary_model "$boundary"

    boundary_bus_factor["$boundary"]="$bus_factor"
    boundary_contributor_count["$boundary"]="${#sorted_rows[@]}"
    boundary_most_active["$boundary"]="$most_active"
    boundary_most_active_engagement["$boundary"]="$most_active_engagement"

  done
}

#
# Read header
#

IFS=$'\t' read -r _header_boundary _header_author _header_commits _header_additions _header_deletions

#
# First pass
#

while IFS=$'\t' read -r boundary author commit_count added deleted; do

  contributors_seen["$author"]=1
  boundaries_seen["$boundary"]=1

  key="$boundary|$author"

  commits["$key"]="$commit_count"
  additions["$key"]="$added"
  deletions["$key"]="$deleted"

  record_churn=$((added + deleted))
  churn["$key"]="$record_churn"

  ((boundary_commits["$boundary"] += commit_count))
  ((boundary_churn["$boundary"] += record_churn))

  debug \
    'boundary=[%s] author=[%s] commits=[%s] churn=[%s]\n' \
    "$boundary" \
    "$author" \
    "$commit_count" \
    "$record_churn"

done

emit_tsv() {

  printf 'boundary\tauthor\tcommits\tadditions\tdeletions\tchurn\tcommit_ownership\tchurn_ownership\tengagement\n'

  for key in "${!commits[@]}"; do

    boundary="${key%%|*}"
    author="${key#*|}"

    commit_count="${commits[$key]}"
    added="${additions[$key]}"
    deleted="${deletions[$key]}"
    record_churn="${churn[$key]}"

    boundary_total_commits="${boundary_commits[$boundary]}"
    boundary_total_churn="${boundary_churn[$boundary]}"

    commit_ownership=$(
      printf '%.2f' \
        "$((\
        10000 * commit_count / boundary_total_commits))e-2"
    )

    churn_ownership=$(
      printf '%.2f' \
        "$((\
        10000 * record_churn / boundary_total_churn))e-2"
    )

    engagement=$(
      printf '%.2f' \
        "$((((\
        10000 * commit_count / boundary_total_commits) + (\
        10000 * record_churn / boundary_total_churn)) / \
        2))e-2"
    )

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$boundary" \
      "$author" \
      "$commit_count" \
      "$added" \
      "$deleted" \
      "$record_churn" \
      "$commit_ownership" \
      "$churn_ownership" \
      "$engagement"
  done
}

emit_pretty() {

  for boundary in "${!boundaries_seen[@]}"; do

    build_boundary_model "$boundary"

    boundary_bus_factor["$boundary"]="$bus_factor"
    boundary_contributor_count["$boundary"]="${#sorted_rows[@]}"
    boundary_most_active["$boundary"]="$most_active"
    boundary_most_active_engagement["$boundary"]="$most_active_engagement"

    # Print this boundary

    printf '\n'
    printf 'Boundary: %s\n' "$boundary"
    printf 'Most Active Contributor: %s (%s%%)\n' \
      "$most_active" \
      "$most_active_engagement"
    printf 'Bus Factor: %s\n' "$bus_factor"
    printf 'Contributors: %s\n' "${#sorted_rows[@]}"
    printf '\n'
    printf '%-30s %10s %10s %10s\n' \
      "Contributor" \
      "Commit%" \
      "Churn%" \
      "Engage%"

    printf '%-30s %10s %10s %10s\n' \
      "-----------" \
      "-------" \
      "------" \
      "-------"

    for row in "${sorted_rows[@]}"; do

      IFS='|' read -r \
        engagement \
        author \
        commit_pct \
        churn_pct <<<"$row"

      printf '%-30s %10s %10s %10s\n' \
        "$author" \
        "$commit_pct" \
        "$churn_pct" \
        "$engagement"

    done
  done
}

emit_pretty_summary() {

  collect_boundary_metrics

  local total_bf=0
  local boundary_count=0

  for boundary in "${!boundary_bus_factor[@]}"; do
    ((total_bf += boundary_bus_factor["$boundary"]))
    ((boundary_count++))
  done

  if ((boundary_count > 0)); then
    average_bf=$(
      printf '%.1f' \
        "$((100 * total_bf / boundary_count))e-2"
    )
  else
    average_bf="0.0"
  fi

  printf 'Repository Summary\n'
  printf '\n'

  printf 'Boundaries: %s\n' \
    "${#boundaries_seen[@]}"

  printf 'Contributors: %s\n' \
    "${#contributors_seen[@]}"

  printf 'Average Bus Factor: %s\n' \
    "$average_bf"

  printf '\n'
  printf 'Boundaries by bus factor (low means high risk)\n'
  printf '\n'

  printf '%-40s %10s\n' \
    "Boundary" \
    "BusFactor"

  printf '%-40s %10s\n' \
    "-------" \
    "---------"

  for boundary in "${!boundary_bus_factor[@]}"; do
    printf '%s\t%s\n' \
      "${boundary_bus_factor[$boundary]}" \
      "$boundary"
  done |
    sort -n |
    while IFS=$'\t' read -r bf boundary; do
      printf '%-40s %10s\n' \
        "$boundary" \
        "$bf"
    done
}

emit_md() {

  for boundary in "${!boundaries_seen[@]}"; do

    build_boundary_model "$boundary"

    boundary_bus_factor["$boundary"]="$bus_factor"
    boundary_contributor_count["$boundary"]="${#sorted_rows[@]}"
    boundary_most_active["$boundary"]="$most_active"
    boundary_most_active_engagement["$boundary"]="$most_active_engagement"

    echo ""
    echo "## $boundary"
    echo

    echo "- Most Active Contributor: $boundary_most_active (${boundary_most_active_engagement["$boundary"]}%)"
    echo "- Bus Factor: $bus_factor"
    printf -- '- Contributors: %s\n' "${#sorted_rows[@]}"
    echo

    echo "| Contributor | Commit % | Churn % | Engagement % |"
    echo "|-------------|----------|---------|--------------|"

    for row in "${sorted_rows[@]}"; do
      IFS='|' read -r \
        engagement \
        author \
        commit_pct \
        churn_pct <<<"$row"

      printf '| %s | %s | %s | %s |\n' \
        "$author" \
        "$commit_pct" \
        "$churn_pct" \
        "$engagement"
    done

  done
}

emit_md_summary() {

  collect_boundary_metrics

  local total_bf=0
  local boundary_count=0

  for boundary in "${!boundary_bus_factor[@]}"; do
    ((total_bf += boundary_bus_factor["$boundary"]))
    ((boundary_count++))
  done

  if ((boundary_count > 0)); then
    average_bf=$(
      printf '%.1f' \
        "$((100 * total_bf / boundary_count))e-2"
    )
  else
    average_bf="0.0"
  fi

  echo "# Repository Summary"
  echo

  echo "- Boundaries: ${#boundaries_seen[@]}"
  echo "- Contributors: ${#contributors_seen[@]}"
  echo "- Average Bus Factor: $average_bf"
  echo

  echo "## Boundaries by bus factor (low means high risk)"
  echo

  echo "| Boundary | Bus Factor |"
  echo "|---------|------------|"

  for boundary in "${!boundary_bus_factor[@]}"; do
    printf '%s\t%s\n' \
      "${boundary_bus_factor[$boundary]}" \
      "$boundary"
  done |
    sort -n |
    while IFS=$'\t' read -r bf boundary; do
      printf '| %s | %s |\n' \
        "$boundary" \
        "$bf"
    done
}

# Run code and render output
case "$FORMAT" in
pretty)
  case "$MODE" in
  report)
    emit_pretty
    ;;
  summary)
    emit_pretty_summary
    ;;
  all | full)
    emit_pretty_summary
    emit_pretty
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    exit 1
    ;;
  esac
  ;;

tsv)
  emit_tsv
  ;;

md)
  case "$MODE" in
  report)
    emit_md
    ;;
  summary)
    emit_md_summary
    ;;
  all | full)
    emit_md_summary
    emit_md
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    exit 1
    ;;
  esac
  ;;

*)
  echo "Unknown format: $FORMAT" >&2
  exit 1
  ;;
esac
